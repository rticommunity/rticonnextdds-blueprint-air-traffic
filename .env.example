# Copy this file to .env.local and replace the placeholders.
# .env.local is ignored by Git and loaded automatically by setup.sourceme and
# the demo_start.sh launcher.

CARTO_BASEMAP_API_KEY=your-CARTO-key
RTI_LICENSE_FILE=/absolute/path/to/rti_license.dat

# Alternatively, set NDDSHOME and omit RTI_LICENSE_FILE. The DDS launcher will
# use $NDDSHOME/rti_license.dat.
# NDDSHOME=/absolute/path/to/rti_connext_dds-7.7.0

# Optional: run a separate, isolated demo on the same network by changing the
# DDS domain ID and/or domain tag (defaults: 0 and airtraffic-USA). Every app
# in one demo must use the same values.
# DOMAIN_ID=0
# DOMAIN_TAG=airtraffic-USA